{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://project-knowledge.dev/schema/authoring/v1/plan.schema.json",
  "title": "Project Knowledge Capture Plan v1",
  "type": "object",
  "required": ["schema", "plan_id", "created_at", "operations", "preconditions", "warnings", "blockers"],
  "properties": {
    "schema": { "const": "pk-capture-plan/v1" },
    "plan_id": { "type": "string", "format": "uuid" },
    "created_at": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "path", "record", "field_origins"],
        "properties": {
          "op": { "const": "create_record" },
          "path": { "type": "string", "minLength": 1 },
          "record": { "type": "object" },
          "field_origins": {
            "type": "object",
            "additionalProperties": { "enum": ["authored", "generated", "observed", "suggested"] }
          }
        },
        "additionalProperties": false
      }
    },
    "preconditions": { "type": "array", "items": { "type": "object" } },
    "warnings": { "type": "array", "items": { "$ref": "#/$defs/message" } },
    "blockers": { "type": "array", "items": { "$ref": "#/$defs/message" } }
  },
  "additionalProperties": false,
  "$defs": {
    "message": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  }
}
